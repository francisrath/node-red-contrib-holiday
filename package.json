{
  "name": "node-red-contrib-holiday",
  "version": "1.3.0",
  "description": "A Node-RED node that routes a message depending on whether the given date is a public holiday or a weekend, for 200+ countries.",
  "repository": {
    "type": "git",
    "url": "https://github.com/francisrath/node-red-contrib-holiday.git"
  },
  "author": "Francis Rath",
  "license": "MIT",
  "keywords": [
    "node-red",
    "holiday",
    "holidays",
    "weekend",
    "public holiday",
    "bank holiday",
    "calendar"
  ],
  "files": [
    "holiday.js",
    "holiday.html"
  ],
  "scripts": {
